# Shared editor helpers — symlinked in by utils/link.sh (the .cs are symlinks
# into ../utils, the .meta are Unity-generated locally; no asset references
# them by GUID, so neither belongs in the repo).
unity/CompleteTinyFont/Editor/CLIBuildHelper.cs
unity/CompleteTinyFont/Editor/CLIBuildHelper.cs.meta
unity/CompleteTinyFont/Editor/CLIPublishHelper.cs
unity/CompleteTinyFont/Editor/CLIPublishHelper.cs.meta
unity/CompleteTinyFont/Editor/LocalizationGenerator.cs
unity/CompleteTinyFont/Editor/LocalizationGenerator.cs.meta

# Glyph tooling is tracked; extracted CK atlases + derived data
# (glyph_metrics.json, grids/, *.png) stay untracked (Pugstorm game assets)
sources/glyph-templates/*
!sources/glyph-templates/*.py
!sources/glyph-templates/README.md
